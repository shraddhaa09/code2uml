# ==============================================================================
# Code2UML AI - Configuration Template
# ==============================================================================

# Option 1: Google AI Studio (Official Gemini & Gemma API)
# Get your free key from Google AI Studio: https://aistudio.google.com/
# Either GEMINI_API_KEY or GEMMA_API_KEY will be automatically recognized.
GEMINI_API_KEY=

# Supported Gemma Models (Default: gemma-4-26b-a4b-it):
# - gemma-4-26b-a4b-it (Recommended modern Gemma 4)
# - gemma-4-31b-it
# - gemma-2-9b-it
# - gemma-2-27b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 2: OpenAI-Compatible Local or Cloud Endpoint (Ollama, vLLM, Groq, OpenRouter)
# Examples:
# For local Ollama:
# GEMMA_API_URL=http://localhost:11434/v1/chat/completions
# GEMMA_MODEL=gemma2:9b
#
# For Groq:
# GEMMA_API_URL=https://api.groq.com/openai/v1/chat/completions
# GEMMA_API_KEY=gsk_...
# GEMMA_MODEL=gemma2-9b-it
#
# GEMMA_API_URL=

# Note: If no API key is configured, Code2UML AI automatically uses its built-in
# deterministic architecture rules engine to answer questions offline.
